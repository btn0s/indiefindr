{
  "name": "indiefindr",
  "version": "0.1.0",
  "description": "Discover indie games through precomputed recommendations",
  "repository": {
    "type": "git",
    "url": "https://github.com/btn0s/indiefindr.git"
  },
  "keywords": [
    "indie-games",
    "game-discovery",
    "steam",
    "recommendations",
    "nextjs"
  ],
  "license": "MIT",
