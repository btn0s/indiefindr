    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.0",
    "jsdom": "^31.0.0",
    "sharp": "^0.34.5",
